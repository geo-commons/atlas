    "es6-promise": "4.2.8",
    "fetch-dot": "1.2.0",
    "geostyler-openlayers-parser": "4.1.2",
    "js-cookie": "3.0.1",
    "markdown-it": "13.0.1",
    "nunjucks": "3.2.4",
    "ol": "7.2.2",
    "proj4": "2.8.1",
    "vue": "2.7.14",
    "vue-resizable": "1.3.4",
    "vue-router": "3.6.5",
    "vue-tippy": "4.16.0",
    "vuex": "3.6.2",
    "whatwg-fetch": "3.6.2"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "5.0.8",
    "@vue/cli-plugin-eslint": "5.0.8",
    "@vue/cli-service": "5.0.8",
    "@vitejs/plugin-legacy": "^2.0.0",
    "@vitejs/plugin-vue2": "^1.1.2",
    "@vue/test-utils": "^1.3.0",
    "babel-eslint": "10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^20.0.0",
    "prettier": "2.8.8",
    "vitest": "^0.18.1",
    "vite": "^3.0.2",
