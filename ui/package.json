{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite preview",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint --ext .js,.vue src",
    "lint:fix": "eslint --ext .js,.vue --fix src",
    "format": "prettier .  --write",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui --ui-host 127.0.0.1",
    "test:e2e:record": "sh -c 'playwright codegen ${E2E_BASE_URL:-http://localhost:8000/atlas/}'",
    "generate-metadata-types": "node scripts/generate-enums.js"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@pinia/colada": "0.21.4",
    "@primevue/themes": "4.3.9",
    "@tanstack/vue-query": "5.92.1",
    "@vee-validate/rules": "4.15.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/compat": "3.5.27",
    "chroma-js": "3.2.0",
    "codemirror": "6.0.2",
    "es6-promise": "4.2.8",
    "fetch-dot": "1.2.0",
    "geostyler-openlayers-parser": "5.1.2",
    "hex-rgb": "5.0.0",
    "html2canvas": "1.4.1",
    "js-cookie": "3.0.5",
    "jspdf": "4.1.0",
    "markdown-it": "14.1.0",
    "nunjucks": "3.2.4",
    "ol": "10.6.1",
    "pinia": "3.0.3",
    "primeicons": "7.0.0",
    "primevue": "4.3.9",
    "proj4": "2.19.10",
    "slugify": "1.6.6",
    "tailwindcss-primeui": "0.6.1",
    "thememirror": "2.0.1",
    "vee-validate": "4.15.1",
    "vite": "7.3.1",
    "vue": "3.5.27",
    "vue-advanced-cropper": "2.8.9",
    "vue-codemirror6": "1.3.22",
    "vue-router": "4.5.1",
    "vue-tippy": "6.7.1",
    "vuedraggable": "4.1.0",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@primevue/auto-import-resolver": "4.3.9",
    "@types/chroma-js": "3.1.1",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22.18.7",
    "@types/nunjucks": "3.2.6",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vue/compiler-sfc": "3.5.27",
    "@vue/runtime-core": "3.5.27",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-vue": "10.7.0",
    "globals": "17.3.0",
    "playwright": "1.58.1",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "sass-embedded": "1.97.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "typescript-eslint": "8.54.0",
    "unplugin-vue-components": "30.0.0",
    "vite-svg-loader": "5.1.0",
    "vitest": "4.0.18",
    "vue-eslint-parser": "10.2.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
